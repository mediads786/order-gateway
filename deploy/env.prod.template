# Reference only. Bootstrap generates .env; never copy placeholder secrets live.
# Deployment hostname only, without scheme, path, or port.
DOMAIN=REPLACE_WITH_HOSTNAME
# Deployment Compose project name; preserve it to keep the same named volumes.
COMPOSE_PROJECT_NAME=order-gateway
# Application ERP adapter; production override also forces mock.
ERP_ADAPTER=mock
# Application mock ERP URL inside the Compose network.
ERP_BASE_URL=http://mock_erp:9001
# Application legacy order API authentication; override also forces key.
LEGACY_AUTH=key
# Application proposer; rule requires no external paid AI API key.
PROPOSER=rule
# Database password: generate 64 hexadecimal characters; URL-safe, no punctuation.
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_HEX
# Application admin login token: generate at least 32 random bytes.
ADMIN_TOKEN=REPLACE_WITH_RANDOM_HEX
# Application Shopify HMAC secret; replace with Shopify's actual signing secret before registration.
SHOPIFY_WEBHOOK_SECRET=REPLACE_WITH_SHOPIFY_SIGNING_SECRET
# Application shipment HMAC secret; shipments remain unsupported with mock ERP.
SHIPMENT_WEBHOOK_SECRET=REPLACE_WITH_RANDOM_HEX
# Deployment Caddy basic-auth username, separate from ADMIN_TOKEN.
CADDY_BASIC_AUTH_USER=gateway
# Deployment plaintext password, saved locally for the operator; never sent to Caddy as an env var.
CADDY_BASIC_AUTH_PASSWORD=REPLACE_WITH_RANDOM_HEX
# Raw bcrypt hash; single-quote to preserve dollars in Bash and Compose .env parsing.
# Do not double dollars here: $$ is for hashes embedded literally in Compose YAML.
# Generate this file with credentials.py, shared by bootstrap and local verification.
CADDY_BASIC_AUTH_HASH='REPLACE_WITH_BCRYPT_HASH'
# Deployment-only operator API key, registered as a hash in api_keys, not an app environment setting.
DEPLOY_OPERATOR_API_KEY=REPLACE_WITH_RANDOM_GW_KEY
# Deployment-only approver API key, registered as a hash; use a different identity for approvals.
DEPLOY_APPROVER_API_KEY=REPLACE_WITH_RANDOM_GW_KEY
# Deployment-only admin API key, registered as a hash; does not replace ADMIN_TOKEN.
DEPLOY_ADMIN_API_KEY=REPLACE_WITH_RANDOM_GW_KEY
# Optional deployment backup bucket NAME only; empty disables S3 upload. Use an instance IAM role.
S3_BACKUP_BUCKET=
